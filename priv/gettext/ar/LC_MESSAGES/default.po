msgstr "أدخل عنوان بريد إلكتروني صالحاً."

msgid "Finish or cancel next-port instructions and clear their onward plan before creating a repeating route."
msgstr "أكمل تعليمات الميناء التالي أو ألغها وأزل خطتها التالية قبل إنشاء مسار متكرر."

msgid "Fuel now requires %{value1}, above the confirmed limit of %{value2}. Review the voyage estimate and confirm again."
msgstr "يتطلب الوقود الآن %{value1}، وهو أعلى من الحد المؤكد %{value2}. راجع تقدير الرحلة وأكّد مجدداً."

msgid "If that email is linked to an account, a sign-in link will arrive shortly."
msgstr "إذا كان هذا البريد مرتبطاً بحساب، فسيصلك رابط تسجيل الدخول قريباً."

msgid "It will be ready in about %{value1} seconds."
msgstr "ستكون جاهزة خلال نحو %{value1} ثانية."

msgid "No invitation entitlement is available."
msgstr "لا توجد دعوات متاحة."

msgid "No voyage is available to this port right now."
msgstr "لا تتوفر رحلة إلى هذا الميناء حالياً."

msgid "Not enough available cash. Check reserved fuel and unpaid costs."
msgstr "النقد المتاح غير كافٍ. تحقق من الوقود المحجوز والتكاليف غير المدفوعة."

msgid "Not enough unreserved cash to buy this ship. Borrow first and retain funds for cargo and voyages."
msgstr "النقد غير المحجوز لا يكفي لشراء هذه السفينة. اقترض أولاً واحتفظ بأموال للبضائع والرحلات."

msgid "Not enough unreserved cash to fund this guarantee."
msgstr "النقد غير المحجوز لا يكفي لتمويل هذا الضمان."

msgid "Only the player's original inviter can provide this guarantee."
msgstr "لا يمكن تقديم هذا الضمان إلا من قِبل الداعي الأصلي للاعب."

msgid "Open the invitation form again and allow cookies before redeeming."
msgstr "افتح نموذج الدعوة مجدداً واسمح بملفات تعريف الارتباط قبل استخدامها."

msgid "Paste the sign-in token from your email for this server. Request a fresh link if it was already used in another browser."
msgstr "الصق رمز تسجيل الدخول من البريد المرسل لهذا الخادم. اطلب رابطاً جديداً إذا استُخدم في متصفح آخر."

msgid "Pay accrued interest plus at least $1 of principal, up to the outstanding balance. Review the current amounts and try again."
msgstr "ادفع الفائدة المستحقة مع دولار واحد على الأقل من أصل القرض، حتى الرصيد القائم. راجع المبالغ وحاول مجدداً."

msgid "Pledge at least $50,000, up to the player's normal credit limit."
msgstr "تعهّد بمبلغ لا يقل عن 50,000 دولار ولا يتجاوز حد ائتمان اللاعب المعتاد."

msgid "Route stops can be edited before starting. Remove the route to replace its plan; committed handling continues."
msgstr "يمكن تعديل المحطات قبل البدء. أزل المسار لاستبدال خطته؛ تستمر المناولة الملتزم بها."

msgid "Select a ship owned by your company before departing."
msgstr "اختر سفينة تملكها شركتك قبل المغادرة."

msgid "Select a ship owned by your company."
msgstr "اختر سفينة تملكها شركتك."

msgid "That cargo exceeds this ship's weight or volume limit."
msgstr "تتجاوز هذه البضاعة حد وزن السفينة أو حجمها."

msgid "That company name is already taken."
msgstr "اسم الشركة مستخدم بالفعل."

msgid "That email cannot be linked or invited. Its owner can use email sign-in instead."
msgstr "لا يمكن ربط هذا البريد أو دعوته. يمكن لمالكه استخدام تسجيل الدخول بالبريد الإلكتروني."

msgid "That instruction is no longer active or does not belong to your company."
msgstr "هذه التعليمة لم تعد نشطة أو لا تنتمي إلى شركتك."

msgid "That invitation could not be redeemed. Check the code and that the game is available."
msgstr "تعذر استخدام الدعوة. تحقق من الرمز ومن توفر اللعبة."

msgid "The action could not be completed. Please refresh and try again."
msgstr "تعذر إكمال الإجراء. حدّث الصفحة وحاول مجدداً."

msgid "The command contains too many fields (maximum 12)."
msgstr "يحتوي الأمر على حقول كثيرة جداً (الحد الأقصى 12)."

msgid "The command payload is too large (maximum 4096 bytes)."
msgstr "حجم بيانات الأمر كبير جداً (الحد الأقصى 4096 بايت)."

msgid "The command payload must be an object."
msgstr "يجب أن تكون بيانات الأمر كائناً."

msgid "The database is unavailable. Please try again later."
msgstr "قاعدة البيانات غير متاحة. حاول لاحقاً."

msgid "The fuel limit is invalid. Review the voyage estimate and confirm again."
msgstr "حد الوقود غير صالح. راجع تقدير الرحلة وأكّد مجدداً."

msgid "The market is changing quickly. Please try again."
msgstr "يتغير السوق بسرعة. حاول مجدداً."

msgid "The market price changed. Review the latest quote and try again."
msgstr "تغير سعر السوق. راجع أحدث سعر وحاول مجدداً."

msgid "The sell target exceeds the selected cargo currently aboard. Reduce the target and try again."
msgstr "يتجاوز هدف البيع كمية البضاعة المختارة على متن السفينة. خفّض الهدف وحاول مجدداً."

msgid "The ship must be at, or sailing toward, the route's selected stop to start or resume."
msgstr "يجب أن تكون السفينة في المحطة المحددة أو مبحرة نحوها لبدء المسار أو استئنافه."

msgid "The ship price has changed. Review it before buying."
msgstr "تغير سعر السفينة. راجعه قبل الشراء."

msgid "The shipyard offer has changed. Review the current value and try again."
msgstr "تغير عرض حوض السفن. راجع القيمة الحالية وحاول مجدداً."

msgid "The world paused after an internal error. Please contact the operator."
msgstr "توقف العالم بعد خطأ داخلي. يرجى التواصل مع المشغّل."

msgid "There is no available sea route from %{value1} to %{value2}. Choose another destination."
msgstr "لا يتوفر مسار بحري من %{value1} إلى %{value2}. اختر وجهة أخرى."

msgid "There is not enough supply at that price."
msgstr "لا يتوفر عرض كافٍ بهذا السعر."

msgid "This email link is invalid, expired, or already used. Request a new link."
msgstr "رابط البريد غير صالح أو منتهي الصلاحية أو مستخدم. اطلب رابطاً جديداً."

msgid "This link belongs to a different account. Sign out before using it; accounts will not be merged."
msgstr "هذا الرابط لحساب آخر. سجّل الخروج قبل استخدامه؛ لن تُدمج الحسابات."

msgid "This player already has an active guarantee."
msgstr "لهذا اللاعب ضمان نشط بالفعل."

msgid "This player does not currently need a guarantee."
msgstr "لا يحتاج هذا اللاعب إلى ضمان حالياً."

msgid "This port cannot buy that quantity right now."
msgstr "لا يمكن لهذا الميناء شراء هذه الكمية الآن."

msgid "This purchase would leave %{value1}, but the voyage to %{value2} needs %{value3} for fuel, canal fees, and estimated fleet upkeep. Buy fewer lots."
msgstr "سيُبقي هذا الشراء %{value1}، لكن الرحلة إلى %{value2} تتطلب %{value3} للوقود ورسوم القنوات وتكاليف الأسطول المقدّرة. اشترِ دفعات أقل."

msgid "This route would take %{value1} minutes, exceeding the 24-hour voyage limit. Choose a closer destination."
msgstr "ستستغرق هذه الرحلة %{value1} دقيقة، فتتجاوز حد الرحلة البالغ 24 ساعة. اختر وجهة أقرب."

msgid "This ship already has 20 active instructions. Cancel one before adding another."
msgstr "لهذه السفينة 20 تعليمة نشطة بالفعل. ألغِ واحدة قبل إضافة أخرى."

msgid "This ship cannot carry that cargo, or its tank already holds a different liquid."
msgstr "لا تستطيع هذه السفينة حمل هذه البضاعة، أو يحتوي خزانها على سائل مختلف."

msgid "This ship has no saved repeating route."
msgstr "ليس لهذه السفينة مسار متكرر محفوظ."

msgid "This ship is %{value1}. "
msgstr "هذه السفينة %{value1}. "

msgid "This ship is already at %{value1}. Choose a different destination."
msgstr "هذه السفينة موجودة بالفعل في %{value1}. اختر وجهة أخرى."

msgid "This ship purchase has already been processed."
msgstr "تمت معالجة شراء هذه السفينة بالفعل."

msgid "This ship uses a repeating route. Use its route controls instead."
msgstr "تستخدم هذه السفينة مساراً متكرراً. استخدم أدوات التحكم في المسار."

msgid "This stop belongs to the current visit or next leg. Edit it after the ship advances."
msgstr "تنتمي هذه المحطة إلى الزيارة الحالية أو المرحلة التالية. عدّلها بعد تقدم السفينة."

msgid "Too many email requests. Please try again later."
msgstr "طلبات البريد كثيرة جداً. حاول لاحقاً."

msgid "Use 1–10,000 lots and a valid nonnegative limit price."
msgstr "استخدم من 1 إلى 10,000 دفعة وسعر حد صالحاً غير سالب."

msgid "Use a company name between 1 and 60 characters."
msgstr "استخدم اسماً للشركة من 1 إلى 60 حرفاً."

msgid "Use one target per cargo and action at each stop, with at most twenty targets per stop."
msgstr "استخدم هدفاً واحداً لكل بضاعة وإجراء في كل محطة، وبحد أقصى عشرين هدفاً للمحطة."

msgid "Wait for its status to update before departing."
msgstr "انتظر تحديث حالة السفينة قبل المغادرة."

msgid "You do not own that much cargo aboard this ship."
msgstr "لا تملك هذه الكمية من البضاعة على متن السفينة."

msgid "Your company must be active with no overdue bills, and unreserved cash must cover your own outstanding loan principal and interest."
msgstr "يجب أن تكون شركتك نشطة دون فواتير متأخرة، وأن يغطي النقد غير المحجوز أصل قرضك القائم وفائدته."

msgid "Your company owes %{value1} in unpaid operating costs. Sell cargo to settle those costs before departing."
msgstr "على شركتك %{value1} من تكاليف التشغيل غير المدفوعة. بِع بضائع لتسويتها قبل المغادرة."

msgid "Your session is invalid or has expired. Please sign in again."
msgstr "جلستك غير صالحة أو منتهية. سجّل الدخول مجدداً."

