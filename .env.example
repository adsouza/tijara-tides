# Server-only settings. Copy to .env.local; use Neon Console values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
# Saved for future use; the application currently uses DATABASE_URL only.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require&channel_binding=require"
